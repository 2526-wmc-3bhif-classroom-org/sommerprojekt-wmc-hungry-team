# Neo4j Configuration
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_PROTOCOL=bolt

# Google APIs
GOOGLE_KEY=your_google_api_key_here

# Frontend
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional Docker port overrides
BACKEND_PORT=3000
FRONTEND_PORT=3001
